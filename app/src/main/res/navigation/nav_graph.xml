<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="io.sc.eppCordova.ui.splash.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splash_to_language"
            app:destination="@id/languageFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/languageFragment"
        android:name="io.sc.eppCordova.ui.language.LanguageFragment"
        android:label="Language"
        tools:layout="@layout/fragment_language">
        <action
            android:id="@+id/action_language_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/languageFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="io.sc.eppCordova.ui.auth.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_otp"
            app:destination="@id/otpFragment" />
    </fragment>

    <fragment
        android:id="@+id/otpFragment"
        android:name="io.sc.eppCordova.ui.auth.OtpFragment"
        android:label="OTP"
        tools:layout="@layout/fragment_otp">
        <action
            android:id="@+id/action_otp_to_lossClaimHome"
            app:destination="@id/lossClaimHomeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/lossClaimHomeFragment"
        android:name="io.sc.eppCordova.lossclaim.ui.LossClaimHomeFragment"
        android:label="Pre-Call Prep"
        tools:layout="@layout/fragment_loss_claim_home">
        <action
            android:id="@+id/action_home_to_camera"
            app:destination="@id/cameraSurveyFragment" />
    </fragment>

    <fragment
        android:id="@+id/cameraSurveyFragment"
        android:name="io.sc.eppCordova.lossclaim.ui.CameraSurveyFragment"
        android:label="Camera Survey"
        tools:layout="@layout/fragment_camera_survey">
        <action
            android:id="@+id/action_camera_to_processing"
            app:destination="@id/processingFragment" />
    </fragment>

    <fragment
        android:id="@+id/processingFragment"
        android:name="io.sc.eppCordova.lossclaim.ui.ProcessingFragment"
        android:label="Processing"
        tools:layout="@layout/fragment_processing">
        <action
            android:id="@+id/action_processing_to_result"
            app:destination="@id/claimResultFragment" />
    </fragment>

    <fragment
        android:id="@+id/claimResultFragment"
        android:name="io.sc.eppCordova.lossclaim.ui.ClaimResultFragment"
        android:label="Claim Result"
        tools:layout="@layout/fragment_claim_result" />

</navigation>