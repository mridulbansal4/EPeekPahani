<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:background="@color/surface">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:srcCompat="@drawable/ic_arrow_back"
            app:tint="@color/primary"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_auto_140"
            android:textColor="@color/primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="48dp"
            android:paddingBottom="32dp">

            <!-- AI Agriculture Logo -->
            <ImageView
                android:id="@+id/iv_otp_illustration"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/ic_ai_agri_logo"
                android:layout_marginBottom="40dp"
                android:contentDescription="AI Agriculture Logo" />

            <!-- OTP Sent To -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_auto_141"
                android:textColor="@color/on_surface_variant"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_phone_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_auto_142"
                android:textColor="@color/on_surface"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="48dp" />

            <!-- OTP Input Boxes -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="32dp">

                <EditText
                    android:id="@+id/et_otp1"
                    android:layout_width="56dp"
                    android:layout_height="64dp"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="1"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_surface"
                    android:background="@drawable/bg_otp_input"
                    android:layout_marginEnd="16dp" />

                <EditText
                    android:id="@+id/et_otp2"
                    android:layout_width="56dp"
                    android:layout_height="64dp"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="1"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_surface"
                    android:background="@drawable/bg_otp_input"
                    android:layout_marginEnd="16dp" />

                <EditText
                    android:id="@+id/et_otp3"
                    android:layout_width="56dp"
                    android:layout_height="64dp"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="1"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_surface"
                    android:background="@drawable/bg_otp_input"
                    android:layout_marginEnd="16dp" />

                <EditText
                    android:id="@+id/et_otp4"
                    android:layout_width="56dp"
                    android:layout_height="64dp"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="1"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_surface"
                    android:background="@drawable/bg_otp_input" />
            </LinearLayout>

            <!-- Resend Timer -->
            <TextView
                android:id="@+id/tv_resend_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_auto_143"
                android:textColor="@color/primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="48dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Confirm Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_verify_otp"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="@string/str_auto_144"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="@color/primary"
                android:textColor="@color/on_primary"
                app:cornerRadius="30dp"
                app:elevation="4dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
